### Archivo para probar la API. Funciona con la extensión "REST Client" de VS Code
### (o con el cliente HTTP de IntelliJ Ultimate). En Postman, usa las mismas rutas.
###
### Orden: 1) iniciar sesión (el token queda guardado en @token), 2) probar el resto.

@base = http://localhost:8080/api

############ AUTENTICACIÓN ############

### Iniciar sesión como ADMIN (guarda el token)
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{
  "correo": "admin@losmaestros.cl",
  "password": "Admin123"
}

###
@token = {{login.response.body.token}}

### Iniciar sesión como USER (contratista)
# @name loginUser
POST {{base}}/auth/login
Content-Type: application/json

{
  "correo": "contratista@losmaestros.cl",
  "password": "Maestro123"
}

###
@tokenUser = {{loginUser.response.body.token}}

### Registrar un usuario nuevo
POST {{base}}/auth/registro
Content-Type: application/json

{
  "nombre": "Maria Soto",
  "correo": "maria@correo.cl",
  "password": "Clave123"
}

### Login con contraseña incorrecta -> 401
POST {{base}}/auth/login
Content-Type: application/json

{
  "correo": "admin@losmaestros.cl",
  "password": "incorrecta1"
}

############ PRODUCTOS (GET es público) ############

### Obtener todos (no necesita token; la respuesta trae _links HATEOAS)
GET {{base}}/productos

### Buscar por ID (SKU)
GET {{base}}/productos/MAT-CEM-001

### Crear (requiere ADMIN)
POST {{base}}/productos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "HER-MAR-010",
  "nombre": "Martillo Carpintero 16oz",
  "categoria": "herramientas-man",
  "categoriaNombre": "Herramientas Manuales",
  "precio": 9990,
  "stock": 25,
  "stockMinimo": 5,
  "ubicacion": "Pasillo C - Estante 1"
}

### Crear sin token -> 401
POST {{base}}/productos
Content-Type: application/json

{ "id": "HER-MAR-011", "nombre": "Martillo", "categoria": "a", "categoriaNombre": "a", "precio": 1000, "stock": 1, "stockMinimo": 1, "ubicacion": "x" }

### Crear con token de USER -> 403
POST {{base}}/productos
Content-Type: application/json
Authorization: Bearer {{tokenUser}}

{ "id": "HER-MAR-011", "nombre": "Martillo", "categoria": "a", "categoriaNombre": "a", "precio": 1000, "stock": 1, "stockMinimo": 1, "ubicacion": "x" }

### Actualizar (requiere ADMIN)
PUT {{base}}/productos/HER-MAR-010
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "HER-MAR-010",
  "nombre": "Martillo Carpintero 16oz Reforzado",
  "categoria": "herramientas-man",
  "categoriaNombre": "Herramientas Manuales",
  "precio": 10990,
  "stock": 30,
  "stockMinimo": 5,
  "ubicacion": "Pasillo C - Estante 1"
}

### Eliminar (requiere ADMIN)
DELETE {{base}}/productos/HER-MAR-010
Authorization: Bearer {{token}}

############ CLIENTES (requieren token) ############

### Obtener todos
GET {{base}}/clientes
Authorization: Bearer {{token}}

### Buscar por ID
GET {{base}}/clientes/1
Authorization: Bearer {{token}}

### Crear
POST {{base}}/clientes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "rut": "76.123.456-0",
  "nombre": "Maestro Pedro Soto",
  "correo": "pedro@correo.cl",
  "telefono": "+56 9 5555 4444",
  "tipoCliente": "contratista",
  "region": "coquimbo",
  "comuna": "Ovalle"
}

### Actualizar
PUT {{base}}/clientes/3
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "rut": "76.123.456-0",
  "nombre": "Maestro Pedro Soto Rojas",
  "correo": "pedro@correo.cl",
  "telefono": "+56 9 5555 4444",
  "tipoCliente": "contratista",
  "region": "coquimbo",
  "comuna": "Ovalle"
}

### Eliminar (requiere ADMIN)
DELETE {{base}}/clientes/3
Authorization: Bearer {{token}}

############ VENTAS (requieren token) ############

### Obtener todas
GET {{base}}/ventas
Authorization: Bearer {{token}}

### Buscar por ID
GET {{base}}/ventas/1
Authorization: Bearer {{token}}

### Crear (el servidor pone la fecha y calcula el total)
POST {{base}}/ventas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clienteId": 1,
  "productoId": "MAT-CEM-001",
  "cantidad": 2,
  "precioUnitario": 4890,
  "tipoEntrega": "retiro",
  "metodoPago": "transferencia"
}

### Actualizar
PUT {{base}}/ventas/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clienteId": 1,
  "productoId": "MAT-CEM-001",
  "cantidad": 3,
  "precioUnitario": 4890,
  "tipoEntrega": "despacho",
  "metodoPago": "tarjeta"
}

### Eliminar (requiere ADMIN)
DELETE {{base}}/ventas/1
Authorization: Bearer {{token}}

############ ERRORES ############

### Clientes sin token -> 401
GET {{base}}/clientes

### SKU inválido -> 400 (con token de ADMIN)
POST {{base}}/productos
Content-Type: application/json
Authorization: Bearer {{token}}

{ "id": "martillo1", "nombre": "X", "categoria": "a", "categoriaNombre": "a", "precio": 0, "stock": -1, "stockMinimo": 0, "ubicacion": "" }

### Producto inexistente -> 404
GET {{base}}/productos/XXX-XXX-999
